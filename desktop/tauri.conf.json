{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL Manager",
  "identifier": "com.lolmanager.app",
  "version": "0.0.0",
  "build": {
    "beforeBuildCommand": "pnpm --filter lol-ui run build",
    "beforeDevCommand": "pnpm --filter lol-ui run dev",
    "frontendDist": "../lol-ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "LoL Manager",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": "downloadBootstrapper"
    }
  }
}
